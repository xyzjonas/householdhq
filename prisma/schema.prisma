// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String

  /// The only role for now: may manage users. The first account is one.
  isSuperuser Boolean @default(false)

  memberships Membership[]
}

/// The tenant. Every table below (except users, sessions and memberships)
/// carries a `householdId`, and the core layer scopes every query to one
/// household, so households never see each other's data. The scoped client
/// stamps `householdId` on every created row; the 0 default only exists so
/// callers need not pass it, and matches no household if it is ever missed.
model Household {
  id        Int      @id @default(autoincrement())
  name      String
  /// A name from the shared icon catalog (see `category-icon-catalog.ts`).
  icon      String   @default("house")
  /// `#rrggbb`
  color     String   @default("#4f46e5")
  createdAt DateTime @default(now())

  memberships Membership[]

  @@map("household")
}

/// Which users belong to which households (many to many).
model Membership {
  userId      Int
  householdId Int
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  household   Household @relation(fields: [householdId], references: [id])

  @@id([userId, householdId])
  @@index([householdId])
  @@map("membership")
}

model Session {
  id          String   @id @db.Char(64) // sha256 of the session token (the token itself is never stored)
  userId      Int
  /// The household the user is currently working in (re-validated on every request).
  householdId Int?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Category {
  id          Int     @id @default(autoincrement())
  householdId Int     @default(0)
  name        String
  description String?
  icon        String?
  color       String?

  transactions Transaction[]
  vehicle      Vehicle?      @relation("VehicleCategory")
  fuelVehicle  Vehicle?      @relation("VehicleFuelCategory")
  mankoSetting AppSettings[] @relation("MankoCategory")

  @@unique([householdId, name])
  @@index([householdId])
  @@map("category")
}

model Tag {
  id          Int     @id @default(autoincrement())
  householdId Int     @default(0)
  name        String
  description String?
  icon        String?
  color       String?

  parentId  Int?
  parentTag Tag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childTags Tag[] @relation("TagHierarchy")

  transactions Transaction[]

  @@unique([householdId, name])
  @@index([parentId])
  @@index([householdId])
  @@map("tag")
}

model SourceState {
  id          Int      @id @default(autoincrement())
  householdId Int      @default(0)
  created     DateTime @updatedAt
  amount      Float
  sourceId    Int
  source      Source   @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([householdId])
}

model Source {
  id              Int           @id @default(autoincrement())
  householdId     Int           @default(0)
  name            String
  transactionsIn  Transaction[] @relation(name: "source")
  transactionsOut Transaction[] @relation(name: "target")
  isOut           Boolean       @default(false) // mark 'source' as output (not owned)
  isDisponible    Boolean       @default(false) // mark 'source' as disponible (available to spend)
  isPortfolio     Boolean       @default(false) // mark 'source' as a part of the portfolio
  states          SourceState[]
  defaultOutOf    AppSettings[] @relation("DefaultOutAccount")
  color           String?
  position        Int           @default(999) // position in the listing
  type            SourceType    @default(ACCOUNT)

  @@index([householdId])
}

enum SourceType {
  OUT
  ACCOUNT
  CASH
  SAVINGS
  INVESTMENT
  RETIREMENT
  DEBT
}

model Transaction {
  id           Int       @id @default(autoincrement())
  householdId  Int       @default(0)
  created      DateTime  @updatedAt
  transactedAt DateTime?
  description  String
  amount       Float
  currency     String
  cancelled    Boolean   @default(false)
  confirmed    Boolean   @default(true)
  recurring    Int       @default(0) // recurring each n months

  isImportant Boolean @default(false) // mark as an important reminder/tracker
  isHidden    Boolean @default(false) // hide (e.g. internal) transactions

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  sourceId Int
  source   Source @relation(name: "source", fields: [sourceId], references: [id])

  projectId Int?
  project   Project? @relation(name: "project", fields: [projectId], references: [id])

  targetId Int    @default(2)
  target   Source @relation(name: "target", fields: [targetId], references: [id])

  vehicleId Int?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  fuelEntry    VehicleFuelEntry?    @relation("FuelEntryTransaction")
  serviceEntry VehicleServiceEntry? @relation("ServiceEntryTransaction")

  tags Tag[]

  @@index([sourceId])
  @@index([targetId])
  @@index([categoryId])
  @@index([projectId])
  @@index([vehicleId])
  @@index([isImportant])
  @@index([householdId])
  @@fulltext([description])
  @@map("transaction")
}

model Project {
  id          Int      @id @default(autoincrement())
  householdId Int      @default(0)
  name        String
  created     DateTime @updatedAt
  description String?
  estimate    Float

  color        String?
  isCompleted  Boolean       @default(false)
  transactions Transaction[] @relation(name: "project")

  @@index([householdId])
}

model Meter {
  id          Int          @id @default(autoincrement())
  householdId Int          @default(0)
  name        String
  created     DateTime     @updatedAt
  unit        String
  icon        String?
  color       String?
  meterNumber String?
  states      MeterState[] @relation(name: "meter")

  @@index([householdId])
}

model MeterState {
  id          Int      @id @default(autoincrement())
  householdId Int      @default(0)
  value       Float
  meteredAt   DateTime
  meterId     Int
  meter       Meter    @relation(name: "meter", fields: [meterId], references: [id])
  isComputed  Boolean  @default(false)

  @@index([meterId])
  @@index([householdId])
}

model Vehicle {
  id                          Int       @id @default(autoincrement())
  householdId                 Int       @default(0)
  vin                         String
  registration                String
  name                        String
  brand                       String
  model                       String
  color                       String?
  icon                        String?
  purchasePrice               Float?
  purchasedAt                 DateTime?
  mass                        Float?
  engineSize                  Float?
  fuelType                    String?
  defaultFuelTransactionTitle String    @default("Fuel")
  maxPower                    Float?
  dateOfFabrication           DateTime?
  dateFirstRegistered         DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  /// Set when the vehicle is deleted; the row is kept so admins can restore it.
  deletedAt                   DateTime?

  categoryId     Int?      @unique
  category       Category? @relation("VehicleCategory", fields: [categoryId], references: [id])
  fuelCategoryId Int?      @unique
  fuelCategory   Category? @relation("VehicleFuelCategory", fields: [fuelCategoryId], references: [id])

  transactions   Transaction[]
  fuelEntries    VehicleFuelEntry[]
  serviceEntries VehicleServiceEntry[]

  @@unique([householdId, vin])
  @@unique([householdId, registration])
  @@index([categoryId])
  @@index([fuelCategoryId])
  @@index([deletedAt])
  @@index([householdId])
  @@map("vehicle")
}

enum VehicleServiceType {
  REGULAR_MAINTENANCE
  DEFECT
  FEES
  UPGRADE
}

model VehicleFuelEntry {
  id          Int      @id @default(autoincrement())
  householdId Int      @default(0)
  fueledAt    DateTime
  odometer    Float
  fuelAmount  Float
  unitPrice   Float
  isFullTank  Boolean  @default(true)

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  transactionId Int
  transaction   Transaction @relation("FuelEntryTransaction", fields: [transactionId], references: [id])

  previousFullTankFuelEntryId Int?
  previousFullTankFuelEntry   VehicleFuelEntry?  @relation("FuelEntryPreviousFullTank", fields: [previousFullTankFuelEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextFuelEntries             VehicleFuelEntry[] @relation("FuelEntryPreviousFullTank")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transactionId])
  @@index([vehicleId])
  @@index([fueledAt])
  @@index([previousFullTankFuelEntryId])
  @@index([householdId])
  @@map("vehicle_fuel_entry")
}

model VehicleServiceEntry {
  id          Int                @id @default(autoincrement())
  householdId Int                @default(0)
  type        VehicleServiceType
  odometer    Float?
  title       String
  servicedAt  DateTime
  description String?

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  transactionId Int
  transaction   Transaction @relation("ServiceEntryTransaction", fields: [transactionId], references: [id])

  components VehicleComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transactionId])
  @@index([vehicleId])
  @@index([servicedAt])
  @@index([type])
  @@index([householdId])
  @@map("vehicle_service_entry")
}

model VehicleComponent {
  id          Int     @id @default(autoincrement())
  householdId Int     @default(0)
  name        String
  icon        String?
  color       String?
  description String?

  serviceEntries VehicleServiceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
  @@index([householdId])
  @@map("vehicle_component")
}

model AppSettings {
  id                     Int       @id @default(autoincrement())
  // one settings row per household
  householdId            Int       @unique @default(0)
  currency               String    @default("USD")
  // day of the month on which a fiscal interval (e.g. payday to payday) starts; 1 = calendar month
  fiscalIntervalStartDay Int       @default(1)
  // category of the adjustment transactions created along with account checkpoints
  mankoCategoryId        Int?
  mankoCategory          Category? @relation("MankoCategory", fields: [mankoCategoryId], references: [id], onDelete: SetNull)
  // external account that expenses (and checkpoint adjustments) are paid to by default
  defaultOutAccountId    Int?
  defaultOutAccount      Source?   @relation("DefaultOutAccount", fields: [defaultOutAccountId], references: [id], onDelete: SetNull)
  // comma-separated modules shown in the navigation (null = all); hiding never blocks routes
  enabledModules         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([mankoCategoryId])
  @@index([defaultOutAccountId])
  @@map("app_settings")
}
